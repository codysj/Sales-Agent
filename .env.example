# Copy to .env for local development:  cp .env.example .env
#
# .env is git-ignored; this template is committed. Never put a real credential, provider key,
# or production connection string in either file (AGENTS.md rule 3). Production configuration
# is out of scope until Q-018 is answered.

APP_ENV=local

# Local PostgreSQL from docker-compose.yml. Throwaway local values, not secrets.
POSTGRES_USER=matrix
POSTGRES_PASSWORD=localdev
POSTGRES_DB=matrix_sales
# 55432 deliberately avoids a clash with any native PostgreSQL on 5432 (see docs/development.md).
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://matrix:localdev@localhost:55432/matrix_sales

# Fail-closed safety switches (spec §17.6 operational controls, §19.6 rollout stages).
# Do not flip any of these until the matching gate in tasks.md §5 is explicitly unlocked:
#   SHADOW_MODE=false          -> requires the relevant stage gate; blocks every external adapter
#   OUTBOUND_EMAIL_ENABLED=true -> requires G-07 (email execution) and G-08 (live outreach)
#   MODEL_PROVIDER=<real>       -> requires G-03 (production-like model data use), Q-012
#   ALLOW_REAL_MODEL_PROVIDER=true -> requires G-03; the second lock, and on its own it still
#                                     constructs nothing, because no real adapter exists (T-050)
SHADOW_MODE=true
OUTBOUND_EMAIL_ENABLED=false
MODEL_PROVIDER=fake
ALLOW_REAL_MODEL_PROVIDER=false

# Shared secret a provider signs its webhooks with (spec §19.4). Blank means *reject every webhook*,
# not "skip the signature check" — an unconfigured endpoint has nothing to verify against, so it
# refuses everything. Left blank here on purpose: Q-004 has chosen no provider, and a real secret
# must never be committed to either file (AGENTS.md rule 3). Tests generate their own per run.
WEBHOOK_SIGNING_SECRET=
